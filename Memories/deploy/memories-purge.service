[Unit]
Description=Remove Memories media after the 30-day trash period

[Service]
Type=oneshot
User=memories
Group=memories
WorkingDirectory=/opt/memories
EnvironmentFile=/etc/memories.env
ExecStart=/opt/memories/.venv/bin/flask --app backend.app:create_app purge-expired
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/memories /srv/memories

[Unit]
Description=Memories family photo library
RequiresMountsFor=/mnt/drive-2
# Listens on the Tailscale address by default, so start after Tailscale and keep retrying
# until its address is ready at boot.
Wants=tailscaled.service
After=network-online.target tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=memories
Group=memories
WorkingDirectory=/opt/memories
EnvironmentFile=/etc/memories.env
ExecStart=/opt/memories/.venv/bin/gunicorn --worker-class gthread --workers 2 --threads 8 --timeout 120 --bind ${MEMORIES_BIND} --access-logfile - --error-logfile - "backend.app:create_app()"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/memories /mnt/drive-2/memories

[Install]
WantedBy=multi-user.target

[Unit]
Description=Remove family library media after the 30-day trash period

[Service]
Type=oneshot
User=family-photos
Group=family-photos
WorkingDirectory=/opt/family-photos
EnvironmentFile=/etc/family-photos.env
ExecStart=/opt/family-photos/.venv/bin/flask --app backend.app:create_app purge-expired
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/family-photos /srv/family-photos

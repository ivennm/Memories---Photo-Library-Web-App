[Unit]
Description=Memories thumbnails and video streaming copies
RequiresMountsFor=/mnt/drive-2
After=memories.service

[Service]
Type=simple
User=memories
Group=memories
WorkingDirectory=/opt/memories
EnvironmentFile=/etc/memories.env
ExecStart=/opt/memories/.venv/bin/flask --app backend.app:create_app process-media --watch
Restart=always
RestartSec=10
# Video conversion is heavy; keep it out of the way of the web app and everything else.
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/memories /mnt/drive-2/memories

[Install]
WantedBy=multi-user.target

[Unit]
Description=Family photo library API
After=network.target

[Service]
Type=simple
User=family-photos
Group=family-photos
WorkingDirectory=/opt/family-photos
EnvironmentFile=/etc/family-photos.env
ExecStart=/opt/family-photos/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - "backend.app:create_app()"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/family-photos /srv/family-photos

[Install]
WantedBy=multi-user.target
